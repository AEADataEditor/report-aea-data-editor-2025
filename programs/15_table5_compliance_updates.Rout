+   group_by(`Update.type`,ticket) %>%
+   summarize(n=n()) %>%
+   ungroup() %>%
+   group_by(`Update.type`) %>%
+   # here we actually allow for multiple updates per MC
+   summarize(`Manuscripts`=sum(n)) %>%
+   rename(Origin = `Update.type`) %>%
+   ungroup() -> update_types
