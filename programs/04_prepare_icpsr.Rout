> 
> if ( file.exists(file.path(icpsrconf,icpsr.utilization.file)) ) {
+ message(paste0("Reading from ",icpsr.utilization.file))
+ utilizationReport <- read_csv(file.path(icpsrconf,icpsr.utilization.file)) %>%
+   select(Project.ID = "Study ID",
+          Status,
+          Views,
+          Downloads  = "Download",
+          Updated.Date = "Updated Date") %>%
+   # blacklist - these are in an ambiguous state
+   mutate(exclude = (Project.ID %in% c(109644,110581,110621,110902,111003))) %>%
+   filter(exclude == FALSE) %>%
+   filter(Status %in% c("PUBLISHED","NEW VERSION IN PROGRESS","SUBMITTED") ) %>%
+   mutate(is_published = (Views >0),
+          as.of.date   = icpsr.utilization.date)
+ 
+ summary(utilizationReport)
+ 
+ # we save this filtered file
+ saveRDS(utilizationReport,file=file.path(icpsrbase,"anonUtilizationReport.Rds"))
+ write_csv(utilizationReport,file=file.path(icpsrbase,"anonUtilizationReport.csv"))
+ } else {
+    message(paste0("File not found: ",icpsrconf,"/",icpsr.utilization.file))
+    message(paste0("Skipping anonymization of ",icpsr.utilization.file))
+    message(paste0("Attempting to read from ",file.path(icpsrbase,"anonUtilizationReport.Rds")))
+    if ( file.exists(file.path(icpsrbase,"anonUtilizationReport.Rds")) ) {
+      utilizationReport <- readRDS(file=file.path(icpsrbase,"anonUtilizationReport.Rds"))
+      summary(utilizationReport)
+    } else {
+      stop(paste0("File not found: ", file.path(icpsrbase,"anonUtilizationReport.Rds")))
+    }
+ 
+ }
