> ## response options
> jira.response.options.detailed <- jira.filter.submitted  %>%  
+   # Issues with empty recommendations should have been filtered out before, checking here
+   mutate(MCRecommendation = case_when( 
+     MCRecommendation == "" & MCStatus == "RR" ~ "No recommendation",
+     MCStatus == "CA" ~ "",
+     TRUE ~ MCRecommendation)) %>%
+   mutate(MCRecommendationV2 = case_when(
+     MCStatus == "RR" ~ "",
+     TRUE ~ MCRecommendationV2
+   )) %>%
+   #distinct(mc_number_anon, .keep_all=TRUE) %>%
+   unite(response,c(MCRecommendationV2,MCRecommendation),remove=FALSE,sep="") %>%
+   distinct(response,MCStatus,mc_number_anon) %>%
+   mutate(Stage = case_when(
+     grepl("CA",MCStatus) ~ "CA",
+     grepl("RR",MCStatus) ~ "RandR"
+   )) 
